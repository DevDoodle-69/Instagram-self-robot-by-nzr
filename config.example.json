{
  "botName": "Alternative Self-Bot",
  "prefix": "^",
  "language": "en",
  "adminBot": [],
  "env": { "token": "set locally", "url": "https://nkx-ica.neokex.xyz" },
  "server": { "url": "https://nkx-ica.neokex.xyz", "token": "set locally", "timeout": 60000 },
  "account": { "proxy": null, "userAgent": null },
  "music": { "enable": true, "apiUrl": "", "apiToken": "" },
  "selfListen": true,
  "noPrefix": false,
  "listenEvents": true,
  "autoMarkRead": false,
  "autoMarkDelivery": true,
  "autoReconnect": true,
  "restartListenInterval": 3600000,
  "antiInbox": false,
  "adminOnly": { "enable": false, "ignoreCommands": [] },
  "whiteList": { "enable": false, "userIDs": [], "threadIDs": [] },
  "hideNotiMessage": { "commandNotFound": false, "adminOnly": false, "userBanned": false, "needRoleToUseCommand": false },
  "cooldown": { "default": 1 },
  "logEvents": { "disableAll": false, "message": true, "message_reply": true, "message_reaction": false, "message_unsend": false, "read_receipt": false, "typ": false },
  "database": { "dir": "storage" },
  "onlineStatus": { "enable": true, "file": "storage/online-status.jsonl", "interval": 60000 }
}
